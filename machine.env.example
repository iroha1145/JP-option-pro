# ホスト固有設定（このファイルを machine.env にコピーして編集）
# machine.env に置ける実行時キーは下記のみ。他のキーは無視される。
HOST_BIND=127.0.0.1
PORT=2100
ALLOWED_HOSTS=127.0.0.1
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_CIDRS=
DATA_DIR=/data
# --- 任意: 訪客アカウント DB（米国版と共有するときだけ設定） -------------
# ACCOUNTS_DB_PATH=/shared-accounts/accounts.db
# --- 任意: 本番用 personal.toml の差し替え先（未設定はイメージ内の既定） ---
# PERSONAL_CONFIG_PATH=/data/personal.toml
# --- compose 補間専用（アプリは読まない） ---------------------------------
# SHARED_ACCOUNTS_DIR=/var/lib/docker/volumes/option-pro_optix-data/_data
# OPTIXJP_SHARED_GROUP=101
