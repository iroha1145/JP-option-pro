# サーバー専用シークレット（このファイルを secrets.env にコピー; chmod 600）
# secrets.env に置けるキーはこの3つだけ。他のキーは無視される。

# J-Quants API V2 の API キー（ダッシュボードで発行; Standard プラン）
JQUANTS_API_KEY=

# ニュース翻訳・分析ジョブ用（news_mode=off の間は不要）
OPENAI_API_KEY=

# access.mode=password の場合のみ必要:
#   .venv/bin/python -c "from app.access import hash_owner_password; print(hash_owner_password('パスワード12文字以上'))"
APP_PASSWORD_HASH=
